# Hosted accounts (Supabase Auth). Leave the key blank to run local-only.
# The project address is fixed in src/lib/auth/hosted.ts because the desktop
# content-security policy allows exactly that origin; moving to another project
# means changing both places.
# The publishable key is safe to ship in a desktop app; the service key never belongs here.
VITE_SUPABASE_ANON_KEY=
